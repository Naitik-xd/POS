# GEMINI_API_KEY / GAPI_POS: Required for Gemini AI API calls.
# AI Studio injects GEMINI_API_KEY, and Vercel deployments can use secret GAPI_POS.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GAPI_POS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Optional live Supabase credentials for production/Vercel deployment:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

